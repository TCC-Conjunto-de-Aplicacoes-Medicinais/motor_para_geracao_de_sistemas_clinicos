# =================================================================
# MOTOR DE GERAÇÃO IAC - VARIÁVEIS DE CONFIGURAÇÃO & FINOPS
# =================================================================

# Porta da API do Motor
PORT=8082

# Chaves AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# FinOps: Tempo de vida (TTL) da clínica na AWS antes da auto-destruição
AUTO_DESTROY_MINUTES=5

# FinOps Switch 1: Chave Geral Liga/Desliga da AWS (true = permite AWS / false = força Sandbox Local)
AWS_ENABLED=true

# FinOps Switch 2: Validação de Whitelist (true = apenas admins da lista / false = desligado, qualquer pessoa pode)
AWS_REQUIRE_WHITELIST=true

# Whitelist de Administradores (separados por vírgula)
AUTHORIZED_ADMIN_EMAILS=admin@pohinc.com.br,isaiascbluz@gmail.com

# FinOps Semáforo: Máximo de instâncias ativas simultaneamente na AWS (evita estouro de quota de VPC)
MAX_CONCURRENT_AWS_INSTANCES=1

# Geração local (sem AWS): só na máquina do admin. No servidor, deixe false.
ALLOW_LOCAL_GENERATE=false
